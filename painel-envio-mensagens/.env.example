# Você normalmente NÃO precisa criar esse arquivo manualmente: na primeira
# vez que o programa abre, a própria tela de configuração inicial cria o
# arquivo .env pra você (usuário/senha do painel + primeiro e-mail Gmail).
#
# Esse arquivo .env.example é só uma referência, útil se você quiser
# cadastrar MAIS DE UMA conta Gmail (pra rotação automática caso uma seja
# bloqueada). Nesse caso, edite o .env real (criado na pasta de dados do
# programa) e adicione linhas seguindo o mesmo padrão, com números
# sequenciais: _1, _2, _3, etc.

GMAIL_USER_1=primeiroemail@gmail.com
GMAIL_APP_PASSWORD_1=xxxx xxxx xxxx xxxx

GMAIL_USER_2=segundoemail@gmail.com
GMAIL_APP_PASSWORD_2=xxxx xxxx xxxx xxxx

# Usuário e senha para acessar o painel (definidos na configuração inicial).
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-esta-senha

# Porta em que o painel roda internamente (padrão: 3000).
PORTA=3000
